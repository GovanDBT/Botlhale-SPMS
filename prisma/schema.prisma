// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
  SCHOOLADMIN
  FACULTY
  STUDENT
}

enum Permission {
  // user management
  USER_VIEW
  USER_CREATE
  USER_UPDATE
  USER_DELETE

  // school management
  SCHOOL_VIEW
  SCHOOL_CREATE
  SCHOOL_UPDATE
  SCHOOL_DELETE

  // role management
  ROLE_VIEW
  ROLE_ASSIGN

  // system settings
  // reports
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model Profile {
  id                  String           @id @db.Uuid
  userId              String           @unique
  firstname           String
  lastname            String
  email               String           @unique
  phone               String           @unique
  role                Role             @default(STUDENT)
  dateCreated         DateTime         @default(now())
  createdBy           String?          @db.Uuid
  createdByUser       Profile?         @relation("CreatedByUser", fields: [createdBy], references: [id])
  dateUpdated         DateTime?        @updatedAt
  updatedBy           String?          @db.Uuid
  updatedByUser       Profile?         @relation("UpdatedByUser", fields: [updatedBy], references: [id])
  isActive            Boolean          @default(true)
  accountStatus       AccountStatus    @default(ACTIVE)
  statusReason        String?
  suspendedUntil      DateTime?
  statusUpdatedAt     DateTime?
  statusUpdatedBy     String?          @db.Uuid
  permissionOverrides UserPermission[]

  // Self-referencing back-relations (required by Prisma)
  createdUsers Profile[] @relation("CreatedByUser")
  UpdatedUsers Profile[] @relation("UpdatedByUser")

  @@map("profiles")
}

// per-user permission overrides (grants or deny on top of role defaults)
model UserPermission {
  id         String     @id @default(cuid())
  userId     String     @db.Uuid
  permission Permission
  granted    Boolean // true=explicitly granted, false=explicitly denied
  user       Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@map("user_permissions")
}
