// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
  SCHOOLADMIN
  FACULTY
  STUDENT
}

model Profile {
  id            String    @id @db.Uuid
  userId        String    @unique
  firstname     String
  lastname      String
  email         String    @unique
  phone         String    @unique
  active        Boolean   @default(true)
  role          Role      @default(STUDENT)
  dateCreated   DateTime  @default(now())
  createdBy     String?   @db.Uuid
  createdByUser Profile?  @relation("CreatedByUser", fields: [createdBy], references: [id])
  dateUpdated   DateTime? @updatedAt
  updatedBy     String?   @db.Uuid
  updatedByUser Profile?  @relation("UpdatedByUser", fields: [updatedBy], references: [id])

  // Self-referencing back-relations (required by Prisma)
  createdUsers Profile[] @relation("CreatedByUser")
  UpdatedUsers Profile[] @relation("UpdatedByUser")

  @@map("profiles")
}
